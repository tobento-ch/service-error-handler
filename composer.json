{
    "name": "tobento/service-error-handler",
    "version": "2.0",
    "type": "library",
    "description": "PHP errors and exceptions handling",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "error handler",
        "exceptions"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",        
        "tobento/service-autowire": "^2.0",
        "tobento/service-view": "^2.0",
        "psr/log": "^3.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-container": "^2.0",
        "monolog/monolog": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\ErrorHandler\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\ErrorHandler\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}